# Government Staff AI Assistant - backend settings. Copy to .env and fill in.
# Separate from the citizen app's backend/.env - never share keys between them.

# development | test | staging | production
ENVIRONMENT=development

# Database. Development may use SQLite (default: data/staff.db).
# Production: PostgreSQL, app connects as a restricted login role that is a member of staff_app_rw.
# DATABASE_URL=postgresql+psycopg://staff_app:<password>@<host>:5432/<db>
# MIGRATION_DATABASE_URL=postgresql+psycopg://<owner>:<password>@<host>:5432/<db>

# Staff frontend origin(s), comma-separated.
CORS_ORIGINS=http://localhost:5180

# P1 - sessions and registration
# 32+ random characters outside development, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
ALLOWED_EMAIL_DOMAINS=rajasthan.gov.in,nic.in

# OTP for verifying new accounts. Testing: every code is OTP_TEST_CODE and nothing is sent.
# Must be empty in staging/production.
OTP_TEST_CODE=1234

# Email delivery (later)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# P2 - document storage
STORAGE_BACKEND=local

# Later phases (not used yet):
# P2  FILE_ENCRYPTION_KEY=  CLAMAV_HOST=  OCR_PROVIDER=
# P3  OPENROUTER_API_KEY=  OPENROUTER_MODEL=
