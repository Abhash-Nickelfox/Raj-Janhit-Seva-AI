# ---- LLM (required for /chat) ------------------------------------------------
# Not validated at import any more; app.config.require_openrouter_key() raises
# on first LLM use, and /health returns 503 while it's missing.
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# ---- Voice input (optional - enables the mic button) --------------------------
SARVAM_API_KEY=your-sarvam-api-key-here
SARVAM_STT_MODEL=saaras:v3
# Language hint sent to Sarvam. hi-IN (default) - "unknown" auto-detect made
# saaras:v3 emit Gurmukhi for Hindi speech. The service retries once with
# en-IN if the transcript comes back in another script.
SARVAM_STT_LANGUAGE=hi-IN
# Legacy Whisper-on-Groq fallback, unused unless stt_service is switched back.
# GROQ_API_KEY=
# GROQ_STT_MODEL=whisper-large-v3-turbo

# ---- HTTP server ---------------------------------------------------------------
# Comma-separated CORS origins. "*" (default) logs a warning at startup.
ALLOWED_ORIGINS=*
# Idle conversations are evicted from memory after this many minutes.
SESSION_TTL_MINUTES=120

# ---- Jan Aadhaar integration ---------------------------------------------------
# "mock" (default) mounts the local fake Sewadwaar routes on this server and
# calls them over HTTP; "real" is a placeholder until departmental onboarding.
JANAADHAAR_MODE=mock
JANAADHAAR_MOCK_BASE_URL=http://localhost:8000
JANAADHAAR_APP_CODE=MOCKAPP01
JANAADHAAR_SCHEME_CODE=MOCKSCM01
JANAADHAAR_CLIENT_ID=mock-client-id
# TESTERS: set this to 1 so the mock's OTP is shown in the browser as a fake
# "SMS arrived" popup. With the default 0 the OTP is ONLY written to the server
# log (logger "janaadhaar_audit", line "mock_sms tid=... otp=..."), never sent
# to the client. Has no effect under JANAADHAAR_MODE=real.
JANAADHAAR_DEMO_OTP_PREVIEW=0
